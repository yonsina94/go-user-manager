// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/go-postgres
{
  "name": "Go & PostgreSQL",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/meaningful-ooo/devcontainer-features/homebrew:2": {},
    "ghcr.io/nikobockerman/devcontainer-features/fish-persistent-data:2": {},
    "ghcr.io/devcontainers/features/node:2.1.0": {
      "version": "lts"
    }
  },

  // Features to add to the dev container. More info: https://containers.dev/features.
  // "features": {},

  // Configure tool-specific properties.
  // "customizations": {},

  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  "forwardPorts": [5173, 8080, 5432, 8025, 1025, 9000, 9001],

  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "bradlc.vscode-tailwindcss",
        "styled-components.vscode-styled-components",
        "streetsidesoftware.code-spell-checker",
        "streetsidesoftware.code-spell-checker-spanish",
        "a-h.templ",
        "tamasfe.even-better-toml",
        "cweijan.vscode-database-client2"
      ]
    }
  },

  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root"
}
