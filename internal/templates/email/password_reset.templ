package emailtemplates

type ResetPasswordProps struct {
	UserName string
	ResetURL string
}

templ PasswordResetEmail(props ResetPasswordProps) {
	<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
	<html xmlns="http://www.w3.org/1999/xhtml" lang="es">
		<head>
			<meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta http-equiv="X-UA-Compatible" content="IE=edge"/>
			<meta name="x-apple-disable-message-reformatting"/>
			<title>Restablecer Contraseña</title>
			<style type="text/css">
				body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
				table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
				img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
				table { border-collapse: collapse !important; }
				body { height: 100% !important; margin: 0 !important; padding: 0 !important; width: 100% !important; background-color: #f9fafb; font-family: Arial, Helvetica, sans-serif; }
				a[x-apple-data-detectors] { color: inherit !important; text-decoration: none !important; font-size: inherit !important; font-family: inherit !important; font-weight: inherit !important; line-height: inherit !important; }
				@media screen and (max-width: 600px) {
					.email-container { width: 100% !important; margin: auto !important; }
					.fluid { max-width: 100% !important; height: auto !important; margin-left: auto !important; margin-right: auto !important; }
					.stack-column, .stack-column-center { display: block !important; width: 100% !important; max-width: 100% !important; direction: ltr !important; }
					.padding-mobile { padding: 20px !important; }
				}
			</style>
		</head>
		<body width="100%" style="margin: 0; padding: 0 !important; mso-line-height-rule: exactly; background-color: #f9fafb;">
			<!-- Texto de preencabezado (Preheader Text) oculto para vista previa en bandeja de entrada -->
			<div style="display: none; font-size: 1px; line-height: 1px; max-height: 0px; max-width: 0px; opacity: 0; overflow: hidden; mso-hide: all; font-family: sans-serif;">
				Solicitud de restablecimiento de contraseña para tu cuenta de GoUserManager.
			</div>
			<!-- Espaciador adicional de preheader para evitar que se muestre texto no deseado -->
			<div style="display: none; font-size: 1px; line-height: 1px; max-height: 0px; max-width: 0px; opacity: 0; overflow: hidden; mso-hide: all;">
				&#847,&#847,&#847,&#847,&#847,&#847,&#847,&#847,&#847,&#847,&#847,&#847,&#847,&#847,&#847,
			</div>

			<table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f9fafb; table-layout: fixed;">
				<tr>
					<td align="center" style="padding: 32px 16px;">
						<!--[if (gte mso 9)|(IE)]>
						<table align="center" border="0" cellspacing="0" cellpadding="0" width="600">
						<tr>
						<td align="center" valign="top" width="600">
						<![endif]-->
						<table border="0" cellpadding="0" cellspacing="0" width="100%" class="email-container" style="max-width: 600px; background-color: #ffffff; border-radius: 12px; border: 1px solid #e5e7eb; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">
							<!-- Encabezado / Logo -->
							<tr>
								<td align="center" style="padding: 32px 32px 16px 32px;">
									<span style="font-family: Arial, Helvetica, sans-serif; font-size: 24px; font-weight: bold; color: #7e22ce; text-decoration: none;">
										⚡ GoUserManager
									</span>
								</td>
							</tr>

							<!-- Contenido Principal -->
							<tr>
								<td style="padding: 16px 32px 32px 32px; font-family: Arial, Helvetica, sans-serif;" class="padding-mobile">
									<h2 style="margin: 0 0 16px 0; font-size: 20px; font-weight: 700; color: #111827; line-height: 1.3;">
										Hola, { props.UserName }
									</h2>
									<p style="margin: 0 0 24px 0; font-size: 15px; color: #4b5563; line-height: 1.6;">
										Has solicitado restablecer la contraseña de tu cuenta. Haz clic en el botón a continuación para definir una nueva contraseña:
									</p>

									<!-- Botón a prueba de balas (Bulletproof Button for Outlook/Gmail) -->
									<table border="0" cellspacing="0" cellpadding="0" width="100%" style="margin: 28px 0;">
										<tr>
											<td align="center">
												<table border="0" cellspacing="0" cellpadding="0">
													<tr>
														<td align="center" bgcolor="#9333ea" style="border-radius: 8px;">
															<a href={ templ.URL(props.ResetURL) } target="_blank" style="font-family: Arial, Helvetica, sans-serif; font-size: 15px; font-weight: bold; color: #ffffff; text-decoration: none; padding: 14px 32px; border-radius: 8px; border: 1px solid #9333ea; display: inline-block; background-color: #9333ea;">
																Restablecer Contraseña
															</a>
														</td>
													</tr>
												</table>
											</td>
										</tr>
									</table>

									<!-- Enlace alternativo en texto plano -->
									<p style="margin: 24px 0 0 0; font-size: 12px; color: #6b7280; line-height: 1.5; word-break: break-all;">
										Si el botón anterior no funciona, copia y pega el siguiente enlace en tu navegador web:
										<br/>
										<a href={ templ.URL(props.ResetURL) } target="_blank" style="color: #9333ea; text-decoration: underline;">
											{ props.ResetURL }
										</a>
									</p>
								</td>
							</tr>

							<!-- Pie de Página -->
							<tr>
								<td style="padding: 20px 32px 28px 32px; background-color: #fcfcfd; border-top: 1px solid #f3f4f6; font-family: Arial, Helvetica, sans-serif; text-align: center;" class="padding-mobile">
									<p style="margin: 0; font-size: 12px; color: #9ca3af; line-height: 1.5;">
										Este enlace expirará en 15 minutos. Si no solicitaste este cambio, puedes ignorar este correo de forma segura.
									</p>
									<p style="margin: 8px 0 0 0; font-size: 11px; color: #d1d5db;">
										&copy; GoUserManager. Todos los derechos reservados.
									</p>
								</td>
							</tr>
						</table>
						<!--[if (gte mso 9)|(IE)]>
						</td>
						</tr>
						</table>
						<![endif]-->
					</td>
				</tr>
			</table>
		</body>
	</html>
}

