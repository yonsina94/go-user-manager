{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Backend (Go)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/main.go",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Debug Frontend (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/user-manager-frontend",
      "preLaunchTask": "Start Frontend Dev Server"
    }
  ],
  "compounds": [
    {
      "name": "Debug Both (Backend & Frontend)",
      "configurations": [
        "Debug Backend (Go)",
        "Debug Frontend (Chrome)"
      ],
      "stopAll": true
    }
  ]
}
